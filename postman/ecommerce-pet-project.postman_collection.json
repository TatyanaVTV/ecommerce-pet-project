	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"var timestamp = Date.now();\r",
					"var randomEmail = \"user_\" + timestamp + \"@example.com\";\r",
					"pm.collectionVariables.set(\"generatedEmail\", randomEmail);\r",
					"console.log(\"Generated Email:\", randomEmail);\r",
					"\r",
					"var randomCategoryName = \"Category_\" + Math.floor(Math.random() * 100000);\r",
					"pm.collectionVariables.set(\"generatedCategoryName\", randomCategoryName);\r",
					"console.log(\"Generated Category Name:\", randomCategoryName);\r",
					"\r",
					"var randomProductName = \"Product_\" + Math.floor(Math.random() * 100000);\r",
					"var randomPrice = (Math.random() * 100).toFixed(2); \r",
					"\r",
					"pm.collectionVariables.set(\"generatedProductName\", randomProductName);\r",
					"pm.collectionVariables.set(\"generatedProductPrice\", Number(randomPrice)); \r",
					"\r",
					"console.log(\"Generated Product Name:\", randomProductName);\r",
					"console.log(\"Generated Product Price:\", randomPrice);"
				]
			}
		},
